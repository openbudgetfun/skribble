{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "json": {
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {
    "textWrap": "never"
  },
  "toml": {},
  "yaml": {
    "indentWidth": 2
  },
  "exec": {
    "commands": [
      {
        "command": "nixfmt",
        "exts": [
          "nix"
        ]
      },
      {
        "command": "shfmt --filename {{file_path}} -i 0",
        "exts": [
          "sh",
          "bash"
        ]
      },
      {
        "command": "dartfmt {{file_path}}",
        "exts": [
          "dart"
        ],
        "stdin": false
      }
    ]
  },
  "excludes": [
    "**/.dart_tool/**",
    "**/build/**",
    "**/.devenv*/**",
    "**/.direnv/**",
    "pubspec.lock",
    "**/pubspec.lock",
    "**/*.dart",
    "**/*.nix",
    "**/*.sh",
    "**/.monochange/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.23.3.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa"
  ]
}
