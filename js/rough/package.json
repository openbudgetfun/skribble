{
  "name": "@skribble.dev/rough",
  "version": "0.0.1",
  "description": "skribble's hand-drawn rendering engine for JavaScript: seeded rough shapes, sketched fills, and pen-shaped ink for SVG, canvas, and any framework. A modern replacement for rough.js.",
  "license": "MIT",
  "author": "Ifiok Jr.",
  "homepage": "https://openbudgetfun.github.io/skribble/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbudgetfun/skribble.git",
    "directory": "js/rough"
  },
  "bugs": "https://github.com/openbudgetfun/skribble/issues",
  "keywords": [
    "hand-drawn",
    "sketch",
    "rough",
    "roughjs",
    "svg",
    "canvas",
    "skribble"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-dual.mjs rough",
    "prepack": "pnpm --filter \"$npm_package_name...\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
