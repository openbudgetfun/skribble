{
  "name": "@skribble.dev/svelte",
  "version": "0.1.0",
  "description": "Hand-drawn SVG sketches for Svelte, drawn by skribble's rough engine. Server-renders the same markup on every build.",
  "license": "MIT",
  "author": "Ifiok Jr.",
  "homepage": "https://openbudgetfun.github.io/skribble/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbudgetfun/skribble.git",
    "directory": "js/svelte"
  },
  "bugs": "https://github.com/openbudgetfun/skribble/issues",
  "keywords": [
    "hand-drawn",
    "sketch",
    "rough",
    "roughjs",
    "svg",
    "svelte",
    "skribble"
  ],
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package --input src/lib --output dist",
    "prepack": "pnpm --filter \"$npm_package_name...\" run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@skribble.dev/rough": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "jsdom": "^27.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
